# The app works without any of these. With none set, it runs in demo mode.
# Pick one: deepseek | anthropic | openai | ollama | demo
LLM_PROVIDER=demo

# Optional: canonical origin used for share links. Defaults to the request origin.
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Optional: local answer storage (defaults to ~/.philos-friend, outside the repo)
# PHILOS_FRIEND_DATA_DIR=/absolute/path/to/philos-friend-data
# ADVISE_RATE_LIMIT=60

# Optional: show estimated cost in the answer trace (USD per million tokens).
# DeepSeek V4 Pro off-peak: $0.66 input / $1.98 output. Peak is double.
# LLM_INPUT_COST_PER_M=0.66
# LLM_OUTPUT_COST_PER_M=1.98

# DeepSeek (maximum quality: V4 Pro, thinking enabled)
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
# LLM_ANALYSIS_MODEL=deepseek-v4-pro
# LLM_CRITIC_MODEL=deepseek-v4-pro
# LLM_AFFIRMATION_MODEL=deepseek-v4-pro
# LLM_WRITER_EFFORT=max
# LLM_CRITIC_EFFORT=max
# LLM_ANALYSIS_EFFORT=high
# LLM_AFFIRMATION_EFFORT=high

# Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# OpenAI-compatible (OpenAI, OpenRouter, LM Studio, etc.)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Local Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.3
# LLM_BASE_URL=http://127.0.0.1:11434
